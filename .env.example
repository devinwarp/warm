# Copy to .env.local. Never commit real keys.

# Context.dev — crawl at onboarding, live lookup mid-call
# CONTEXT_API_KEY is also accepted, matching Context.dev's own SDK fallback.
CONTEXT_DEV_API_KEY=

# Crawl level for /api/crawl. Optional; also overridable per request
# via { maxPages, maxDepth } in the POST body. Defaults: 8 pages, depth 1.
CRAWL_MAX_PAGES=
CRAWL_MAX_DEPTH=

# OpenRouter — the crawl -> Fact Sheet extraction pass
OPENROUTER_API_KEY=
# Optional. Default: google/gemini-3.1-flash-lite
OPENROUTER_MODEL=

# ElevenLabs — agent config and the browser widget
ELEVENLABS_API_KEY=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Supabase — fact sheet cache only
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Apify — Google Maps place search, both canvas flows
APIFY_TOKEN=

# ElevenLabs — the Concierge agent that runs the canvas at /
NEXT_PUBLIC_ELEVENLABS_CONCIERGE_AGENT_ID=

# ElevenLabs — the Booker agent that places the outbound booking call,
# and the Twilio number imported into ElevenLabs that it calls from.
ELEVENLABS_BOOKER_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# The only numbers /api/book may dial. Comma-separated, E.164.
# Empty means nothing may be dialled — that is deliberate, not a bug.
DEMO_BOOKING_NUMBERS=
